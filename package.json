{
  "name": "soundguard",
  "version": "0.2.2",
  "private": true,
  "description": "SoundGuard · Rust/egui decibel monitoring and remote intercom system",
  "scripts": {
    "setup": "npm install --prefix web",
    "build:web": "npm run build --prefix web",
    "build:server": "cargo build --release --manifest-path server/Cargo.toml",
    "build:client": "cargo build --release --locked --manifest-path client-native/Cargo.toml",
    "build:collect": "node scripts/collect-release.mjs",
    "build": "npm run build:web && npm run build:server && npm run build:client && npm run build:collect",
    "dev:web": "npm run dev --prefix web",
    "dev:server": "cargo run --manifest-path server/Cargo.toml",
    "dev:client": "cargo run --manifest-path client-native/Cargo.toml",
    "test:server": "cargo test --manifest-path server/Cargo.toml",
    "seed": "node scripts/seed-demo.mjs",
    "package:linux": "bash scripts/package-linux.sh",
    "build:android": "cd mobile/android && gradlew.bat assembleRelease",
    "test:integration": "node scripts/test-integration.mjs",
    "test:audio": "bash scripts/test-client-core.sh",
    "build:installers": "powershell -ExecutionPolicy Bypass -File scripts/build-installers.ps1",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "npm run version:bump && npm run build:web && npm run build:server && npm run build:client && npm run build:client:win7 && npm run build:installers",
    "build:client:win7": "powershell -ExecutionPolicy Bypass -File scripts/build-win7.ps1"
  }
}
