# Server
PORT=8080
BIND_ADDR=0.0.0.0
DATA_DIR=data
WEB_DIST=web/dist
PUBLIC_BASE_URL=http://127.0.0.1:8080

# Admin account. Leave ADMIN_PASSWORD/JWT_SECRET empty to auto-generate secure
# values on first start. The initial admin password is written to
# data/initial-admin-password.txt (username: admin).
ADMIN_PASSWORD=
ADMIN_EMAIL=
JWT_SECRET=
JWT_TTL_HOURS=24

# Initial device created only when the data store has no devices.
# Leave DEVICE_TOKEN empty to generate one in data/initial-device-token.
DEVICE_ID=
DEVICE_NAME=
DEVICE_TOKEN=
# Password used by the Windows client to open settings / close. CHANGE IT.
STOP_PIN=

# Alert policy. Explicit values here override saved global settings on every
# start; remove a variable to let the dashboard value take effect again.
THRESHOLD_DB=65
ALERT_TO=admin@example.com
REPORT_TO=admin@example.com
DAILY_REPORT_ENABLED=true
DAILY_REPORT_TIME=08:00
OFFLINE_TIMEOUT_SECS=45
ALERT_COOLDOWN_SECS=300
# Evidence always covers the full 30-second window; EVIDENCE_SECONDS is fixed at 30.
AUTO_RECORD_EVIDENCE=true
RETENTION_DAYS=30

# SMTP. If SMTP_HOST is empty, mail is written to data/outbox as a dry-run.
# For QQ Mail use smtp.qq.com:587 and an authorization code as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=soundguard@example.com
SMTP_FROM_NAME=声垣 SoundGuard
# starttls (587), wrapper/ssl (465), or none (local relay only).
SMTP_TLS=starttls

# ICE servers for WebRTC. Add a TURN server with credentials for internet use.
ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# Optional CORS allow-list. Leave empty for permissive LAN/development access.
# Include the Android WebView origin when locking this down:
# CORS_ORIGINS=https://sound.example.com,https://appassets.androidplatform.net

# Optional native HTTPS. When both files exist the server serves HTTPS/WSS
# directly. Otherwise terminate TLS at Nginx/Caddy.
# TLS_CERT=/etc/soundguard/fullchain.pem
# TLS_KEY=/etc/soundguard/privkey.pem

# Production: keep the audio encryption key OUTSIDE the data volume/backup,
# for example /etc/soundguard/media-key. If unset, data/media-key is used.
# MEDIA_KEY_FILE=/etc/soundguard/media-key
